# ── Credentials (seulement si pas de profil Chrome) ──────────────────────────
DECYPHA_EMAIL=your_login
DECYPHA_PASSWORD=your_password

# ── Profil Chrome (RECOMMANDÉ si déjà connecté sur Chrome) ───────────────────
# Copier le chemin ci-dessous et remplacer HP par ton nom d'utilisateur Windows
# Chrome doit être FERMÉ avant de lancer l'agent !
CHROME_PROFILE=C:\Users\HP\AppData\Local\Google\Chrome\User Data

# ── Paramètres de téléchargement ─────────────────────────────────────────────
DOWNLOAD_DIR=./downloads
HEADLESS=false

# ── Chemin optionnel vers Chrome (si Playwright ne le trouve pas) ─────────────
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
