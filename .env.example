# Decypha credentials - copy to .env and fill in
DECYPHA_EMAIL=your_login
DECYPHA_PASSWORD=your_password

# Download settings
DOWNLOAD_DIR=./downloads
HEADLESS=true

# Optional: path to Chrome/Chromium executable (leave empty to use Playwright's bundled browser)
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# Mac example:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example:   /usr/bin/google-chrome
BROWSER_PATH=
